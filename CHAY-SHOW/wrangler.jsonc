{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "game",
  "main": "./worker.js",
  "compatibility_date": "2026-09-30",
  "assets": {
    "directory": "./dist",
    "binding": "STATIC",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "game",
      "database_id": "5d0864fc-4a20-447e-9b6a-4d27667e66e9"
    }
  ],
  "r2_buckets": [
    {
      "binding": "ASSETS",
      "bucket_name": "game"
    }
  ],
  "vars": {
    "GAME_NAME": "VẠN NGHỀ",
    "GAME_VERSION": "2.0.0"
  }
}
